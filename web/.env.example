# Copy to .env (or .env.local) and fill in from `supabase start` for local dev,
# or the project's API settings page for a deployed backend.
#
# Left unset, the app builds and runs fully offline — no backend at all
# (see CLAUDE.md). Sync is an enhancement, never a requirement.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Only needed to point resource calls somewhere other than
# ${VITE_SUPABASE_URL}/functions/v1 — e.g. a local server during development.
# VITE_API_BASE_URL=
