# Copy to supabase/.env — `supabase start` loads it automatically for the
# env(...) substitutions in config.toml. Never commit the real file (it's
# gitignored); this is only the list of names it needs.
#
# From a Google Cloud OAuth client (console.cloud.google.com → APIs &
# Services → Credentials → OAuth client ID, type "Web application"). Add the
# callback URL `supabase start` prints under Auth as an authorized redirect
# URI — locally that's http://127.0.0.1:54321/auth/v1/callback.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
